[
 {
  "id": "01",
  "at": 4.1,
  "end": 11.9,
  "text": "上期视频的教程来了。很多人在评论区问：这到底是怎么做出来的？",
  "speed": 1.2
 },
 {
  "id": "02",
  "at": 11.9,
  "end": 18.6,
  "text": "做这种视频有两种方法：写提示词，或者丢一个对标视频。先看第一种，拿Codex演示。",
  "speed": 1.2
 },
 {
  "id": "03",
  "at": 18.7,
  "end": 25.3,
  "text": "把这段提示词丢给Codex，它会自己写代码、自己渲染。",
  "speed": 1.2
 },
 {
  "id": "04",
  "at": 25.6,
  "end": 33.4,
  "text": "连剪辑软件的界面，都是它自己画的。做出来的，就是上期那支视频。",
  "speed": 1.2
 },
 {
  "id": "05",
  "at": 33.7,
  "end": 40.8,
  "text": "这就是那段提示词。看着很长，其实结构很清楚。",
  "speed": 1.2
 },
 {
  "id": "06",
  "at": 41.0,
  "end": 44.4,
  "text": "提示词怎么写？拆成六块说清楚。",
  "speed": 1.2
 },
 {
  "id": "07",
  "at": 44.7,
  "end": 54.3,
  "text": "第一块，动效。别说酷一点，直接点名：3D翻入、旋转甩出、波浪字、巨字砸落，十三个动作全写清楚。",
  "speed": 1.2
 },
 {
  "id": "08",
  "at": 54.7,
  "end": 63.3,
  "text": "第二块，风格。背景什么颜色、星星什么颜色、用什么字体，直接给色号，别让AI去猜。",
  "speed": 1.2
 },
 {
  "id": "09",
  "at": 63.7,
  "end": 72.3,
  "text": "第三块，文案。每一句话几秒出现、字有多大、怎么动，都要写出来。",
  "speed": 1.2
 },
 {
  "id": "10",
  "at": 72.7,
  "end": 80.3,
  "text": "第四块，节奏。给出BPM，比如一百二，所有转场和砸字，都卡在拍子上。",
  "speed": 1.2
 },
 {
  "id": "11",
  "at": 80.7,
  "end": 89.3,
  "text": "第五块，规格。时长、尺寸、帧率，一开始就说死。",
  "speed": 1.2
 },
 {
  "id": "12",
  "at": 89.7,
  "end": 97.3,
  "text": "最后一块，验收。让AI做完自己抽帧检查，巨字砸落那两帧，必须实心、不能半透明。",
  "speed": 1.2
 },
 {
  "id": "13",
  "at": 97.7,
  "end": 103.3,
  "text": "那不会写提示词怎么办？很简单，把想学的视频直接丢给AI。",
  "speed": 1.2
 },
 {
  "id": "14",
  "at": 103.7,
  "end": 109.3,
  "text": "第一步，把对标视频发给AI。",
  "speed": 1.2
 },
 {
  "id": "15",
  "at": 109.7,
  "end": 115.3,
  "text": "第二步，让它把视频逐帧拆开，排成一张大图。",
  "speed": 1.2
 },
 {
  "id": "16",
  "at": 115.7,
  "end": 120.3,
  "text": "第三步，测出每个字的位置、大小和颜色。",
  "speed": 1.2
 },
 {
  "id": "17",
  "at": 120.7,
  "end": 126.3,
  "text": "第四步，和原片逐帧对比，有偏差就继续修。",
  "speed": 1.2
 },
 {
  "id": "18",
  "at": 126.7,
  "end": 131.3,
  "text": "最后，就能得到一支非常接近原片的复刻。",
  "speed": 1.2
 },
 {
  "id": "19",
  "at": 131.7,
  "end": 141.3,
  "text": "学会以后，想换一种风格，只要改两句描述：动效和风格，其他全部不变。比如这样。",
  "speed": 1.2
 },
 {
  "id": "20",
  "at": 151.7,
  "end": 157.8,
  "text": "需要这份提示词的，评论区留言。我们下期见！",
  "speed": 1.2
 }
]